<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../local.props" Condition="Exists('../../local.props')" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.1</Version>
    <Sts2Path Condition="'$(Sts2Path)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
    <Sts2Architecture Condition="'$(Sts2Architecture)' == ''">arm64</Sts2Architecture>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_$(Sts2Architecture)</Sts2DataDir>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <None Update="Chowayo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="local-audio/*.wav" CopyToOutputDirectory="PreserveNewest" TargetPath="audio/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="Set Sts2DataDir to the game's managed assembly directory." />
  </Target>
  <Target Name="DeployMod" DependsOnTargets="Build">
    <PropertyGroup>
      <ModInstallDir>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/Chowayo</ModInstallDir>
    </PropertyGroup>
    <MakeDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Chowayo.json" DestinationFolder="$(ModInstallDir)" />
    <ItemGroup>
      <LocalAudio Include="$(MSBuildProjectDirectory)/local-audio/*.wav" />
    </ItemGroup>
    <MakeDir Directories="$(ModInstallDir)/audio" Condition="'@(LocalAudio)' != ''" />
    <Copy SourceFiles="@(LocalAudio)" DestinationFolder="$(ModInstallDir)/audio" Condition="'@(LocalAudio)' != ''" />
    <Message Text="Installed Chowayo: $(ModInstallDir)" Importance="high" />
  </Target>
</Project>
